# ------------------------
# PostgreSQL
# ------------------------
POSTGRES_DB=renteasebd
POSTGRES_USER=rentease
POSTGRES_PASSWORD=change_this_db_user_password

# ------------------------
# App Ports (docker-compose)
# ------------------------
FRONTEND_PORT=5175
BACKEND_PORT=8080

# ------------------------
# Security (Required)
# ------------------------
# Comma-separated browser origins that can call backend API.
CORS_ALLOWED_ORIGINS=http://localhost:5175

# Base64 PKCS8 private key + Base64 X509 public key (RSA 2048+)
JWT_PRIVATE_KEY_B64=replace_with_base64_pkcs8_private_key
JWT_PUBLIC_KEY_B64=replace_with_base64_x509_public_key

# Base64 32-byte AES key for PII encryption at rest.
PII_AES256_KEY_B64=replace_with_base64_32_byte_key

# Public URL used in invoice links.
PUBLIC_INVOICE_BASE_URL=http://localhost:8080

# ------------------------
# Optional Hardening
# ------------------------
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
JAVA_TOOL_OPTIONS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

# ------------------------
# One-Time Bootstrap Admin
# Keep disabled after first successful owner creation.
# ------------------------
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=owner@rentease.bd
APP_BOOTSTRAP_ADMIN_PASSWORD=Owner@123
